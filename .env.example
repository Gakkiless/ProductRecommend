OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
SONGTSAM_GDS_BASE_URL=https://gds.songtsam.com
SONGTSAM_UNIT_CODE=SONGTSAM
# Preferred: auto-login through Songtsam SSO. Keep these only in local .env.
SONGTSAM_UC_BASE_URL=https://i.songtsam.com
SONGTSAM_ORG_CODE=SONGTSAM
SONGTSAM_USER_CODE=your_songtsam_user_code_here
SONGTSAM_PASSWORD=your_songtsam_encrypted_password_here
SONGTSAM_PASSWORD_MODE=auto
SONGTSAM_TOKEN_TTL_MS=3000000
# Fallback if auto-login is not configured.
SONGTSAM_AUTH_TOKEN=your_songtsam_gds_token_here
PORT=3000
